# Oracle EM connection
EM_BASE_URL=https://your-em-host:7799/em
EM_USER=sysman
EM_PASSWORD=your_password_here

# SSL — set to true and provide CA_BUNDLE path for production
EM_SSL_VERIFY=false
EM_CA_BUNDLE=

# Connection timeout in seconds
EM_TIMEOUT=60

# MCP server settings
MCP_PORT=8090
MCP_TRANSPORT=sse

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
